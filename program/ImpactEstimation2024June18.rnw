<div id="LC270" class="react-code-text react-code-line-contents-no-virtualization react-file-line html-div "><span class="pl-c1">\vspace</span>{1.0ex}<span class="pl-c1">\setlength</span>{<span class="pl-c1">\itemsep</span>}{1.0ex}<span class="pl-c1">\setlength</span>{<span class="pl-c1">\baselineskip</span>}{12pt}</div>
